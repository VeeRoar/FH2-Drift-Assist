DRIFT_MENU_TEXT(Description, "Automatic countersteer for the car you drive, with adjustable steering response and chase camera.", "為目前駕駛的車輛提供自動反打，可調整轉向反應與追車鏡頭。")
DRIFT_MENU_TEXT(EnabledLabel, "Drift assist", "漂移輔助")
DRIFT_MENU_TEXT(EnabledHelp, "Applies automatic countersteer and quick steering to your current car. Switch off to use the usual steering controls.", "為目前車輛啟用自動反打與快速轉向。關閉後恢復原本的轉向操作。")
DRIFT_MENU_TEXT(StrengthLabel, "Countersteer strength (%)", "自動反打強度（%）")
DRIFT_MENU_TEXT(StrengthHelp, "Raise this for stronger automatic countersteer as the rear slides. Set to 0 to use the usual steering controls.", "調高後，車尾滑出時的自動反打會更強。設為 0 可恢復原本的轉向操作。")
DRIFT_MENU_TEXT(SteeringSpeedLabel, "Steering input speed (%)", "打方向速度（%）")
DRIFT_MENU_TEXT(SteeringSpeedHelp, "Controls how quickly the front wheels respond when you turn or reverse direction with the stick or keys. Default 100%.", "控制推動搖桿或按下方向鍵時，前輪打方向與換向的速度。預設 100%。")
DRIFT_MENU_TEXT(ReleaseSpeedLabel, "Steering release speed (%)", "鬆手回盤速度（%）")
DRIFT_MENU_TEXT(ReleaseSpeedHelp, "Controls how quickly the wheels follow the assisted angle when you release steering. Lower it for a gentler unwind. Default 100%.", "放開方向鍵或讓搖桿回到中央時，控制前輪跟隨輔助角度的速度。調低會讓回盤更柔和。預設 100%。")
DRIFT_MENU_TEXT(DeadzoneLabel, "Steering deadzone (%)", "轉向中央死區（%）")
DRIFT_MENU_TEXT(DeadzoneHelp, "Ignores small steering inputs near centre. Raise it if the stick drifts. Full steering-key input still reaches full travel. Default 4%.", "忽略靠近中央的微小轉向輸入。搖桿會自行偏移時可調高。方向鍵按到底仍保有完整輸入幅度。預設 4%。")
DRIFT_MENU_TEXT(FrontSlipLabel, "Front slip window (deg)", "前輪滑移容許角（度）")
DRIFT_MENU_TEXT(FrontSlipHelp, "At speed, a smaller angle keeps the front wheels closer to their direction of travel. A larger angle gives you more steering room. Default 12 degrees.", "車速提高後，角度越小，前輪越貼近輪胎的行進方向；角度越大，手動轉向空間越多。預設 12 度。")
DRIFT_MENU_TEXT(ChaseCameraLabel, "Drift chase camera", "漂移追車鏡頭")
DRIFT_MENU_TEXT(CockpitSyncLabel, "Cockpit steering sync", "座艙轉向同步")
DRIFT_MENU_TEXT(CockpitSyncHelp, "Match the driver's steering animation to the actual front wheels during drift assist.", "漂移輔助啟用時，讓駕駛的轉向動作跟隨前輪實際轉角。")
DRIFT_MENU_TEXT(ChaseCameraHelp, "Moves the chase camera pivot toward the front axle so the rear of the car swings across the view. Applies to both chase views.", "將追車鏡頭的旋轉中心移向前軸，讓車尾擺動更明顯。近、遠兩種追車視角皆適用。")
